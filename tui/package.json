{
  "name": "yaelocus-tui",
  "version": "1.6.0",
  "private": true,
  "description": "YaeLocus React Ink Terminal UI",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "esbuild src/index.tsx --bundle --platform=node --format=esm --external:react --external:ink --external:ink-text-input --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "fuse.js": "^7.3.0",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
