# 高德地图 API Key
# 申请地址: https://lbs.amap.com/
# 类型: Web服务 Key
AMAP_KEY=your_amap_key_here

# 百度地图 AK
# 申请地址: https://lbs.baidu.com/
# 类型: 服务端 AK
BAIDU_AK=your_baidu_ak_here

# 天地图 TK
# 申请地址: http://lbs.tianditu.gov.cn/
# 类型: 应用 Key
TIANDITU_TK=your_tianditu_tk_here

# ====================
# AI 集成（可选，默认关闭）
# ====================
# 启用 AI 功能
AI_ENABLED=false
# AI 供应商: deepseek / qwen / glm / moonshot
AI_PROVIDER=deepseek
# AI 模型名（留空使用供应商默认）
AI_MODEL=

# AI 供应商 API Keys（至少配置一个）
# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
# 通义千问: https://help.aliyun.com/zh/model-studio/
QWEN_API_KEY=sk-your_qwen_api_key_here
# 智谱 GLM: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here
# Kimi (Moonshot): https://platform.moonshot.cn/
MOONSHOT_API_KEY=sk-your_moonshot_api_key_here

# ====================
# 路线规划模式（可选）
# ====================
# 路线规划模式: ai（默认，零外部成本，使用 AI 估算路线）
#                api（使用高德/百度付费方向 API）
ROUTING_MODE=ai
# 当 AI 模式估算失败时是否自动回退到付费 API
ROUTING_AUTO_FALLBACK=false